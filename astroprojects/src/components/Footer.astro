---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} TECH☆TECH. All rights reserved.
</footer>

<style>
	footer {
		padding: var(--spacing-md) var(--spacing-sm) var(--spacing-xl) var(--spacing-sm);
		background-color: var(--color-bg);
		color: var(--color-muted);
		text-align: center;
        border-top: 1px solid var(--color-border);
        margin-top: var(--spacing-lg);
		transition: border-color var(--transition-slow) var(--ease-standard), background-color var(--transition-slow) var(--ease-standard);
		font-size: 0.9rem;
	}
</style>
