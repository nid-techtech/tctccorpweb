---
const { class: className, ...rest } = Astro.props;
---
<div class:list={["p5-canvas-container", className]} {...rest}></div>
<script>
    import { createSketch } from "@/scripts/test.js";

    const containers = document.querySelectorAll(".p5-canvas-container");
    containers.forEach((container) => {
        createSketch(container);
    });
</script>

<style>
    .p5-canvas-container {
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>
