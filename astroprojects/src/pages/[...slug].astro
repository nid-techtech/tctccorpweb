---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const blogEntries = await getCollection("docs");
    return blogEntries
        .filter((entry) => entry.slug !== "index")
        .filter((entry) => !entry.data.draft) // Hide drafts
        .map((entry) => ({
            params: { slug: entry.slug },
            props: { entry },
        }));
}

interface Props {
    entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// h1〜h3を目次に表示する（#, ##, ### すべて対応）
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<BaseLayout
    title={entry.data.title || "TECH☆TECH"}
    description={entry.data.description}
>
    <Header />
    <main class:list={[tocHeadings.length > 0 ? 'has-toc' : '']}>
        <article class="prose">
            <header class="article-header">
                <h1>{entry.data.title}</h1>
                {
                    entry.data.subtitle && (
                        <p class="subtitle">{entry.data.subtitle}</p>
                    )
                }
                <div class="meta">
                    <span class="date"
                        >Created: {
                            entry.data.created_at?.toLocaleDateString()
                        }</span
                    >
                    {
                        entry.data.updated_at && (
                            <span class="date">
                                Updated:{" "}
                                {entry.data.updated_at.toLocaleDateString()}
                            </span>
                        )
                    }
                    {
                        entry.data.author && (
                            <span class="author">By {entry.data.author}</span>
                        )
                    }
                </div>
                {
                    entry.data.tags && entry.data.tags.length > 0 && (
                        <div class="tags">
                            {entry.data.tags.map((tag) => (
                                <a class="tag" href={`/${tag}`}>
                                    #{tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </header>
            <Content />
        </article>
        {tocHeadings.length > 0 && (
            <nav class="toc" aria-label="目次">
                <p class="toc-title">目次</p>
                <ul>
                    {tocHeadings.map((h) => (
                        <li class:list={[`toc-h${h.depth}`]}>
                            <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
                        </li>
                    ))}
                </ul>
            </nav>
        )}
    </main>
    <Footer />
</BaseLayout>

<style>
    main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* 目次あるときは2カラムgrid */
    main.has-toc {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 2rem;
        align-items: start;
        max-width: 1300px;
    }

    .cover-image img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 2rem;
    }
    .prose {
        line-height: 1.6;
        min-width: 0; /* grid内でのオーバーフロー防止 */
    }
    .article-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1rem;
        transition: border-color var(--transition-slow) var(--ease-standard);
    }
    .subtitle {
        font-size: 1.2rem;
        color: var(--color-muted);
        margin: 0.5rem 0;
        transition: color var(--transition-slow) var(--ease-standard);
    }
    .meta {
        font-size: 0.9rem;
        color: var(--color-muted);
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
        transition: color var(--transition-slow) var(--ease-standard);
    }
    .tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }
    .tag {
        background: var(--color-code-bg);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        text-decoration: none;
        color: var(--color-muted);
        transition:
            background-color var(--transition-fast) var(--ease-out),
            color var(--transition-fast) var(--ease-out);
    }
    .tag:hover {
        background: var(--color-primary);
        color: #fff;
    }

    /* === TOC サイドバー === */
    .toc {
        position: sticky;
        top: 5rem; /* ヘッダー分オフセット */
        font-size: 0.85rem;
        border-left: 2px solid var(--color-border);
        padding-left: 1rem;
        transition: border-color var(--transition-slow) var(--ease-standard);
    }

    .toc-title {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin: 0 0 0.75rem;
    }

    .toc ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .toc li a {
        color: var(--color-muted);
        text-decoration: none;
        display: block;
        line-height: 1.4;
        transition: color var(--transition-fast) var(--ease-out);
    }

    .toc li a:hover {
        color: var(--color-primary);
    }

    /* 見出しレベルごとのインデント */
    .toc-h1 {
        padding-left: 0;
        font-weight: 600;
    }
    .toc-h2 {
        padding-left: 0.9rem;
    }
    .toc-h3 {
        padding-left: 1.8rem;
        font-size: 0.8rem;
    }

    /* モバイルではTOCを非表示、通常の1カラムに戻す */
    @media (max-width: 900px) {
        main.has-toc {
            display: block;
        }
        .toc {
            display: none;
        }
    }
</style>

<script>
// IntersectionObserver で現在表示中の見出しをTOCでハイライト
const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]');
if (tocLinks.length > 0) {
    const headingEls: Element[] = [];
    tocLinks.forEach(link => {
        const slug = link.dataset.slug;
        if (slug) {
            const el = document.getElementById(slug);
            if (el) headingEls.push(el);
        }
    });

    let activeSlug = '';

    const observer = new IntersectionObserver(
        (entries) => {
            // ビューポート内に入った見出しのうち、最も上にあるものをアクティブにする
            const visible = entries.filter(e => e.isIntersecting);
            if (visible.length > 0) {
                // 複数同時に見えているときは最初（最上部）のものを優先
                const topEntry = visible.reduce((a, b) =>
                    a.boundingClientRect.top < b.boundingClientRect.top ? a : b
                );
                activeSlug = topEntry.target.id;
            }
            // アクティブクラスの付け替え
            tocLinks.forEach(link => {
                if (link.dataset.slug === activeSlug) {
                    link.classList.add('is-active');
                } else {
                    link.classList.remove('is-active');
                }
            });
        },
        {
            // ページ上部33%に入ったタイミングで反応させる
            rootMargin: '0px 0px -70% 0px',
            threshold: 0
        }
    );

    headingEls.forEach(el => observer.observe(el));
}
</script>
