---
/**
 * 全コンテンツ一覧ページ (/articles)
 * draft: false のすべての記事をまとめて表示する。
 * カテゴリや形式で分けずに一覧できるため、管理・確認用途にも適している。
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const allDocs = await getCollection("docs");
const posts = allDocs
    .filter((doc) => doc.slug !== "index")
    .filter((doc) => !doc.data.draft)
    .sort((a, b) => {
        // 公開日（created_at）基準で降順ソート
        // updated_at は更新管理には使うが、一覧の並び順には影響させない
        const dateA = new Date(a.data.created_at);
        const dateB = new Date(b.data.created_at);
        return dateB.getTime() - dateA.getTime();
    });
---

<BaseLayout
    title="Articles | TECH☆TECH"
    description="TECH☆TECHのすべての記事一覧"
>
    <Header />
    <main>
        <section class="page-header">
            <h1>Articles</h1>
            <p>すべての記事がここにあります</p>
        </section>

        <div class="post-list">
            {
                posts.length > 0 ? (
                    <ul>
                        {posts.map((post) => (
                            <li>
                                <article class="post-card">
                                    {post.data.cover && (
                                        <div class="post-cover">
                                            <Image
                                                src={post.data.cover}
                                                alt={post.data.title}
                                                width={300}
                                                height={200}
                                                format="webp"
                                            />
                                        </div>
                                    )}
                                    <div class="post-content">
                                        <h2>
                                            <a
                                                href={`/${post.slug}`}
                                                class="stretched-link"
                                            >
                                                {post.data.title}
                                            </a>
                                        </h2>
                                        <div class="meta">
                                            <span class="author-date">
                                                by{" "}
                                                {post.data.author ||
                                                    "TECH☆TECH"}{" "}
                                                on{" "}
                                                {post.data.created_at
                                                    ? new Date(
                                                          post.data.created_at,
                                                      ).toLocaleDateString(
                                                          "ja-JP",
                                                      )
                                                    : ""}
                                            </span>
                                            <span class="separator">|</span>
                                            <span class="char-count">
                                                {post.body
                                                    ? post.body.length
                                                    : 0}{" "}
                                                文字
                                            </span>
                                        </div>
                                        {post.data.description && (
                                            <p class="description">
                                                {post.data.description}
                                            </p>
                                        )}
                                        {post.data.tags &&
                                            post.data.tags.length > 0 && (
                                                <div class="tags">
                                                    {((tags) => {
                                                        const categories = [
                                                            "blog",
                                                            "works",
                                                            "info",
                                                        ];
                                                        const catTags =
                                                            tags.filter((t) =>
                                                                categories.includes(
                                                                    t,
                                                                ),
                                                            );
                                                        const elemTags =
                                                            tags.filter(
                                                                (t) =>
                                                                    !categories.includes(
                                                                        t,
                                                                    ),
                                                            );
                                                        return [
                                                            ...catTags,
                                                            ...elemTags,
                                                        ].map((t) => (
                                                            <a
                                                                class="tag-link"
                                                                href={`/${t}`}
                                                            >
                                                                #{t}
                                                            </a>
                                                        ));
                                                    })(post.data.tags || [])}
                                                </div>
                                            )}
                                    </div>
                                </article>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p>まだ記事がありません。</p>
                )
            }
        </div>
    </main>
    <Footer />
</BaseLayout>

<style>
    main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
    .page-header {
        margin-bottom: 3rem;
        text-align: center;
    }
    .page-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.25rem;
    }
    .post-list ul {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }
    .post-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        border: none;
        border-radius: 4px;
        overflow: hidden;
        background: var(--color-bg-card, #f9f9f9);
        box-shadow: none;
        transition:
            box-shadow var(--transition-fast) var(--ease-standard),
            background-color var(--transition-slow) var(--ease-standard),
            transform var(--transition-fast) var(--ease-standard);
    }
    .post-card:hover {
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        transform: translateY(-4px);
        background: var(--color-bg-card-hover, #ffffff);
    }
    .stretched-link::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1;
    }
    .post-cover {
        width: 100%;
        aspect-ratio: 16 / 9;
        flex-shrink: 0;
        overflow: hidden;
    }
    .post-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--transition-normal) var(--ease-standard);
    }
    .post-card:hover .post-cover img {
        transform: scale(1.05);
    }
    .post-content {
        padding: 1.2rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 0.5rem;
    }
    .post-content h2 {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--color-text);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8em;
        transition: color var(--transition-slow) var(--ease-standard);
    }
    .meta {
        font-size: 0.8rem;
        color: var(--color-muted, #777);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        transition: color var(--transition-slow) var(--ease-standard);
    }
    .separator {
        opacity: 0.5;
    }
    .description {
        margin: 0;
        font-size: 0.85rem;
        color: var(--color-text);
        opacity: 0.8;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color var(--transition-slow) var(--ease-standard);
    }
    .tags {
        position: relative;
        z-index: 2;
        display: inline-flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-top: auto;
    }
    .tag-link {
        color: var(--color-primary, #0070f3);
        text-decoration: none;
        transition: opacity var(--transition-fast) var(--ease-standard);
        font-size: 0.85rem;
    }
    .tag-link:hover {
        opacity: 0.7;
        text-decoration: underline;
    }
    /* 開発環境でのみ表示されるDRAFTバッジ */
    .draft-badge {
        display: inline-block;
        background: #f59e0b;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
        letter-spacing: 0.05em;
    }
    a {
        text-decoration: none;
        color: inherit;
    }
</style>
