---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
import P5Intaraction from "../components/P5Intaraction.astro";
import RecentPosts from "../components/RecentPosts.astro";

const title = "TECH☆TECH";
const description =
    "A collective of developers and creators pushing the boundaries of technology and design.";
---

<BaseLayout title={title} description={description}>
    <Preloader />
    <Header />
    <div class="hero-container">
        <P5Intaraction class="p5-top" />
        <section class="top">
            <h1 class="hero-title">
                <span class="reveal-text"><span>Design,</span></span><br />
                <span class="reveal-text stagger-1"
                    ><span>Technology,</span></span
                ><br />
                <span class="reveal-text stagger-2"><span>Play.</span></span>
            </h1>
        </section>
    </div>
    <main>
        <section class="about">
            <p class="eyebrow-heading">_about</p>
            <h2>What is TECH☆TECH?</h2>
            <p>
                私たちはデザイン、テクノロジーはたまた遊びなど、分野を問わずに相互に情報を共有、実践するサークルです。
            </p>
            <p>
                長岡造形大学の公認学生サークルとして毎年各種イベントに参加しています。
            </p>
        </section>
        <section class="content">
            <RecentPosts count={3} />
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    main {
        max-width: 1200px;
        margin-inline: auto;
        padding: var(--spacing-lg)
            clamp(var(--spacing-sm), 5vw, var(--spacing-lg));
    }

    .hero-container {
        position: relative;
        width: 100%;
        height: calc(100vh - var(--spacing-lg));
        overflow: hidden;
        isolation: isolate;
    }

    .p5-top {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .top {
        position: absolute;
        bottom: 10vw;
        left: 10vw;
        z-index: 10;
        pointer-events: none;
        color: #000000;
    }

    h1 {
        font-size: clamp(2.5rem, 10vh, 10vw);
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.02em;
    }

    h2 {
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 400;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .content {
        animation: fadeIn 1s var(--ease-standard) 0.4s forwards;
        opacity: 0;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
